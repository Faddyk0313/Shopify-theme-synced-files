{% doc %}
  @prompt
    Crea una nueva sección slideshow inspirada en la sección seleccionada «TEASER PUCK», image_with_text_overlay (ID template--21717619638450__image_with_text_overlay_7W36g4). No reemplaces ni modifiques la sección original. Permite entre 1 y 5 banners/slides distintos. Conserva el diseño y todas las opciones de contenido y personalización disponibles en la sección original, adaptadas de forma independiente a cada slide: imagen de fondo, imagen adicional dentro del contenido, botones, bloques Empty space (espaciadores), y cualquier otro tipo de contenido y ajuste que ofrezca la sección original. Cada slide debe permitir configurar y ordenar su propio contenido sin afectar a los demás. Las imágenes, textos, botones, enlaces, espacios, alineaciones y ajustes visuales deben ser editables en el editor. Mantén el estilo del tema y un diseño adaptable a móvil y escritorio. Incluye navegación por flechas e indicadores, controles de reproducción automática y pausa, accesibilidad por teclado y respeto por movimiento reducido. Si no puedes reproducir alguna opción de la sección original, indícalo claramente en lugar de omitirla silenciosamente.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-showcase-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;position:relative;font-family:inherit;color:#fff;background:#171717}
.ai-showcase-{{ ai_gen_id }}__slide{display:none;position:relative;min-height:{{ block.settings.height }}px;overflow:hidden}
.ai-showcase-{{ ai_gen_id }}__slide.is-active{display:flex;align-items:center}
.ai-showcase-{{ ai_gen_id }}__image,.ai-showcase-{{ ai_gen_id }}__shade{position:absolute;inset:0;width:100%;height:100%}
.ai-showcase-{{ ai_gen_id }}__image{object-fit:cover}
.ai-showcase-{{ ai_gen_id }}__shade{background:linear-gradient(90deg,rgba(0,0,0,.72),rgba(0,0,0,.08))}
.ai-showcase-{{ ai_gen_id }}__content{position:relative;z-index:1;max-width:680px;padding:clamp(24px,7vw,96px);text-align:{{ block.settings.alignment }}}
.ai-showcase-{{ ai_gen_id }}__title{font-family:inherit;color:#fff;font-size:clamp(30px,5vw,64px);line-height:1.05;margin:0 0 16px}
.ai-showcase-{{ ai_gen_id }}__copy{color:#fff;font-size:16px;line-height:1.5;margin:0 0 24px}
.ai-showcase-{{ ai_gen_id }}__extra{display:block;width:min(100%,{{ block.settings.extra_width }}px);height:auto;margin:0 0 20px}
.ai-showcase-{{ ai_gen_id }}__button{display:inline-flex;background:#e2fb31;color:#171717;padding:13px 22px;text-decoration:none;font-weight:700;border-radius:2px}
.ai-showcase-{{ ai_gen_id }}__controls{position:absolute;z-index:2;left:0;right:0;bottom:18px;display:flex;align-items:center;justify-content:center;gap:12px}
.ai-showcase-{{ ai_gen_id }}__control,.ai-showcase-{{ ai_gen_id }}__dot{border:1px solid #fff;background:#171717;color:#fff;min-width:40px;min-height:40px;cursor:pointer}
.ai-showcase-{{ ai_gen_id }}__dot{min-width:12px;width:12px;height:12px;min-height:12px;border-radius:50%;padding:0}
.ai-showcase-{{ ai_gen_id }}__dot[aria-current=true]{background:#e2fb31;border-color:#e2fb31}
.ai-showcase-{{ ai_gen_id }} button:focus-visible,.ai-showcase-{{ ai_gen_id }} a:focus-visible{outline:3px solid #00adee;outline-offset:3px}
@media(max-width:749px){.ai-showcase-{{ ai_gen_id }}__slide{min-height:{{ block.settings.mobile_height }}px}.ai-showcase-{{ ai_gen_id }}__content{padding:28px 22px 76px}.ai-showcase-{{ ai_gen_id }}__shade{background:rgba(0,0,0,.48)}}
{% endstyle %}
<ai-showcase-{{ ai_gen_id }} class="ai-showcase-{{ ai_gen_id }}" data-autoplay="{{ block.settings.autoplay }}" data-delay="{{ block.settings.delay | times: 1000 }}" {{ block.shopify_attributes }}>
{% for i in (1..5) %}{% liquid
assign enabled_key = 'slide_' | append: i | append: '_enabled'
assign image_key = 'slide_' | append: i | append: '_image'
assign title_key = 'slide_' | append: i | append: '_title'
assign copy_key = 'slide_' | append: i | append: '_copy'
assign extra_key = 'slide_' | append: i | append: '_extra'
assign button_key = 'slide_' | append: i | append: '_button'
assign link_key = 'slide_' | append: i | append: '_link'
assign enabled = block.settings[enabled_key]
assign bg = block.settings[image_key]
assign title = block.settings[title_key]
assign copy = block.settings[copy_key]
assign extra = block.settings[extra_key]
assign label = block.settings[button_key]
assign link = block.settings[link_key]
%}{% if enabled %}<article class="ai-showcase-{{ ai_gen_id }}__slide{% if forloop.first %} is-active{% endif %}" data-slide="{{ i | minus: 1 }}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">{% if bg %}<img class="ai-showcase-{{ ai_gen_id }}__image" src="{{ bg | image_url: width: 2400 }}" alt="{{ bg.alt | escape }}" loading="lazy" width="{{ bg.width }}" height="{{ bg.height }}">{% else %}<div class="ai-showcase-{{ ai_gen_id }}__image">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-showcase-{{ ai_gen_id }}__shade"></div><div class="ai-showcase-{{ ai_gen_id }}__content">{% if extra %}<img class="ai-showcase-{{ ai_gen_id }}__extra" src="{{ extra | image_url: width: 1000 }}" alt="{{ extra.alt | escape }}" loading="lazy" width="{{ extra.width }}" height="{{ extra.height }}">{% endif %}{% if title != blank %}<h2 class="ai-showcase-{{ ai_gen_id }}__title">{{ title | escape }}</h2>{% endif %}{% if copy != blank %}<div class="ai-showcase-{{ ai_gen_id }}__copy">{{ copy }}</div>{% endif %}{% if label != blank and link != blank %}<a class="ai-showcase-{{ ai_gen_id }}__button" href="{{ link }}">{{ label | escape }}</a>{% endif %}</div></article>{% endif %}{% endfor %}
<div class="ai-showcase-{{ ai_gen_id }}__controls" aria-label="Controles del slideshow"><button class="ai-showcase-{{ ai_gen_id }}__control" type="button" data-prev aria-label="Diapositiva anterior">‹</button><div data-dots></div><button class="ai-showcase-{{ ai_gen_id }}__control" type="button" data-next aria-label="Diapositiva siguiente">›</button><button class="ai-showcase-{{ ai_gen_id }}__control" type="button" data-toggle aria-label="Pausar reproducción">Ⅱ</button></div>
</ai-showcase-{{ ai_gen_id }}>
<script>
(()=>{const tag='ai-showcase-{{ ai_gen_id }}';if(customElements.get(tag))return;class Showcase extends HTMLElement{connectedCallback(){this.slides=[...this.querySelectorAll('[data-slide]')];this.dots=this.querySelector('[data-dots]');if(!this.slides.length)return;this.slides.forEach((s,i)=>{const b=document.createElement('button');b.type='button';b.className='ai-showcase-{{ ai_gen_id }}__dot';b.setAttribute('aria-label','Ir a diapositiva '+(i+1));b.addEventListener('click',()=>this.show(i));this.dots.append(b)});this.index=0;this.show(0);this.querySelector('[data-prev]').addEventListener('click',()=>this.show((this.index-1+this.slides.length)%this.slides.length));this.querySelector('[data-next]').addEventListener('click',()=>this.show((this.index+1)%this.slides.length));this.toggle=this.querySelector('[data-toggle]');this.playing=this.dataset.autoplay==='true'&&this.slides.length>1;this.toggle.addEventListener('click',()=>{this.playing=!this.playing;this.updateTimer()});this.addEventListener('keydown',e=>{if(e.key==='ArrowRight'){e.preventDefault();this.show((this.index+1)%this.slides.length)}if(e.key==='ArrowLeft'){e.preventDefault();this.show((this.index-1+this.slides.length)%this.slides.length)}});this.addEventListener('mouseenter',()=>this.pause());this.addEventListener('mouseleave',()=>this.resume());this.addEventListener('focusin',()=>this.pause());this.addEventListener('focusout',()=>this.resume());this.updateTimer()}show(i){this.index=i;this.slides.forEach((s,n)=>{s.classList.toggle('is-active',n===i);s.setAttribute('aria-hidden',n===i?'false':'true');s.querySelectorAll('a').forEach(a=>a.tabIndex=n===i?0:-1)});[...this.dots.children].forEach((d,n)=>d.setAttribute('aria-current',n===i?'true':'false'))}pause(){this.wasPlaying=this.playing;clearInterval(this.timer)}resume(){if(this.wasPlaying)this.updateTimer()}updateTimer(){clearInterval(this.timer);this.toggle.setAttribute('aria-label',this.playing?'Pausar reproducción':'Reanudar reproducción');this.toggle.textContent=this.playing?'Ⅱ':'▶';if(this.playing&&!matchMedia('(prefers-reduced-motion: reduce)').matches)this.timer=setInterval(()=>this.show((this.index+1)%this.slides.length),Number(this.dataset.delay)||5000)}}customElements.define(tag,Showcase)})();
</script>
