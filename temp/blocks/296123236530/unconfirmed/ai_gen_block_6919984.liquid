{% doc %}
  @prompt
    Large bold text filled with an image. Include a setting to control the background color.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-image-text-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    background-color: {{ block.settings.background_color }};
    overflow: hidden;
  }

  .ai-image-text__heading-{{ ai_gen_id }} {
    margin: 0;
    color: transparent;
    background-color: {{ block.settings.text_fallback_color }};
    {% if block.settings.image %}
      background-image: url('{{ block.settings.image | image_url: width: 2400 }}');
      background-size: cover;
      background-position: {{ block.settings.image_position }};
    {% endif %}
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-size: {{ block.settings.text_size }}px;
    font-weight: 800;
    letter-spacing: {{ block.settings.letter_spacing }}px;
    line-height: 0.9;
    text-align: {{ block.settings.alignment }};
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 749px) {
    .ai-image-text__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-image-text-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <h2 class="ai-image-text__heading-{{ ai_gen_id }}">{{ block.settings.text | escape }}</h2>
</div>

{% schema %}
{
  "name": "Image-filled text",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Built for the battle"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Text image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f2f2f2"
    },
    {
      "type": "color",
      "id": "text_fallback_color",
      "label": "Fallback text",
      "default": "#171717"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "inter_n7"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 40,
      "max": 240,
      "step": 10,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "mobile_text_size",
      "label": "Mobile text size",
      "min": 28,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -5,
      "max": 10,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "label": "Vertical padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "label": "Horizontal padding",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Image-filled text"
    }
  ],
  "tag": null,
  "class": "image-filled-text-block"
}
{% endschema %}