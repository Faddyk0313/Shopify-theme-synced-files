{%- doc -%}
  Renders in-stock size pills for a product card. Each pill links to the PDP with that
  variant force-preselected via ?variant=ID.

  Only sizes with available inventory are rendered.

  @param {object} product - Shopify product object
  @param {object} [collection] - Collection for url_for scoping

  @example
  {% render 'product-card-size-pills', product: product %}
{%- enddoc -%}

{%- if product != blank -%}
  {%- liquid
    assign size_option_index = 0
    for option in product.options_with_values
      assign downcased_option = option.name | downcase
      if downcased_option contains 'size'
        assign size_option_index = option.position
        break
      endif
    endfor
  -%}

  {%- if size_option_index > 0 -%}
    {%- liquid
      assign rendered_sizes = ''
      assign pills = ''

      for variant in product.variants
        case size_option_index
          when 1
            assign size_value = variant.option1
          when 2
            assign size_value = variant.option2
          when 3
            assign size_value = variant.option3
        endcase

        assign size_value = size_value | strip
        if size_value == blank
          continue
        endif

        unless variant.available
          continue
        endunless

        if variant.inventory_management != null and variant.inventory_policy == 'deny' and variant.inventory_quantity <= 0
          continue
        endif

        assign size_key = '|' | append: size_value | append: '|'
        if rendered_sizes contains size_key
          continue
        endif
        assign rendered_sizes = rendered_sizes | append: size_key

        assign pill_url = variant.url | within: collection
        if settings.product_disable_collection_portion
          assign pill_url = variant.url
        endif

        assign escaped_size = size_value | escape
      -%}
      {%- capture pill -%}
        <a class="product-card__size-pill" href="{{ pill_url }}" title="{{ escaped_size }}">{{ escaped_size }}</a>
      {%- endcapture -%}
      {%- liquid
        assign pills = pills | append: pill
      endfor
    -%}

    {%- if pills != blank -%}
      <div class="product-card__size-pills flex flex-wrap items-center gap-1 w-full">
        {{ pills }}
      </div>
    {%- endif -%}
  {%- endif -%}
{%- endif -%}
