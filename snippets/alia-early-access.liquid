{% comment %}
  BFCM26 early-access pop-up (Alia manual-open campaign).
  - Any page loaded with ?early-access opens the pop-up, then drops the param.
  ALIA_CAMPAIGN_ID: the live BFCM26 pop-up is 58234 (Dahaus, published Mon 11/16). Put 58234 below once it is live.
  (36740 = "BAU - Design Refresh", the live pop-up, used only for testing until then.)
{% endcomment %}
<script>
  (function () {
    var ALIA_CAMPAIGN_ID = 58234;
    function openAlia() {
      window.alia = window.alia || [];
      window.alia.push({ type: 'open', campaignID: ALIA_CAMPAIGN_ID, ignoreTargeting: true });
    }
    var params = new URLSearchParams(window.location.search);
    if (params.has('early-access')) {
      openAlia();
      params.delete('early-access');
      var q = params.toString();
      history.replaceState(null, '', window.location.pathname + (q ? '?' + q : '') + window.location.hash);
    }
  })();
</script>
