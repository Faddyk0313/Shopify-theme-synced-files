ssage.innerHTML = \"\";\n            }\n        }\n\n        function updateMessage() {\n            let quantity = parseInt(quantityInput.value, 10);\n            calculateDiscount(quantity);\n        }\n\n        function observePriceChanges() {\n            if (!priceContainer) return;\n            const observer = new MutationObserver(() => {\n                priceElement = priceContainer.querySelector(\".price__regular\"); // Update reference\n                updateMessage(); // Recalculate discount\n            });\n\n            observer.observe(priceContainer, { childList: true, subtree: true });\n        }\n\n        quantityInput.addEventListener(\"input\", updateMessage);\n        quantityInput.addEventListener(\"change\", updateMessage);\n\n        if (minusButton) minusButton.addEventListener(\"click\", () => setTimeout(updateMessage, 50));\n        if (plusButton) plusButton.addEventListener(\"click\", () => setTimeout(updateMessage, 50));\n\n        observePriceChanges(); // Watch for price updates\n        updateMessage(); // Initial discount calculation\n    }\n\n    updateDiscountMessage();\n});\n</script>"
