{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign total_steps = step_blocks.size
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    {%- if total_steps == 0 -%}
      {%- if request.design_mode -%}
        <p>{{ 'Add at least one Step block to render this form.' }}</p>
      {%- endif -%}
    {%- else -%}
      <hubspot-form
        class="hs-form"
        data-portal-id="{{ section.settings.portal_id }}"
        data-form-guid="{{ section.settings.form_guid }}"
        data-page-name="{{ page_title | default: shop.name | escape }}"
        data-submit-endpoint="{{ section.settings.submit_endpoint }}"
        data-form-name="{{ section.settings.form_name | escape }}"
        data-error-message="{{ section.settings.error_message | escape }}"
        data-required-message="{{ section.settings.required_message | escape }}"
        data-loading-label="{{ section.settings.loading_label | escape }}"
        data-branch-rules="{{ section.settings.branch_rules | escape }}"
        data-gate-field="{{ section.settings.gate_field }}"
        data-upload-endpoint="{{ section.settings.upload_endpoint }}"
        data-consent-mode="{{ section.settings.consent_mode }}"
        data-consent-subscription-id="{{ section.settings.consent_subscription_id }}"
        data-consent-text="{{ section.settings.consent_text | escape }}"
      >
        <form novalidate>
          {%- for step in step_blocks -%}
            {%- liquid
              assign index = forloop.index
              assign is_first = false
              assign is_last = false
              if forloop.first
                assign is_first = true
              endif
              if forloop.last
                assign is_last = true
              endif
            -%}
            {%- render 'hubspot-form-step',
              step: step,
              section: section,
              index: index,
              total: total_steps,
              is_first: is_first,
              is_last: is_last
            -%}
          {%- endfor -%}

          {%- comment -%}Spam trap: hidden from people, tempting to bots. Never sent to HubSpot.{%- endcomment -%}
          <div class="sr-only" aria-hidden="true">
            <label for="HsTrap-{{ section.id }}">{{ 'Leave this field empty' }}</label>
            <input type="text" id="HsTrap-{{ section.id }}" name="website_hp" tabindex="-1" autocomplete="off" data-honeypot>
          </div>
        </form>

        <div class="hs-form__success rte" data-success hidden>
          {%- if section.settings.success_heading != blank -%}
            <{{ section.settings.step_heading_tag }} class="{{ section.settings.step_heading_size | default: 'title-sm' }}">{{ section.settings.success_heading }}</{{ section.settings.step_heading_tag }}>
          {%- endif -%}
          {{ section.settings.success_message }}

          {%- if section.settings.success_image != blank or section.settings.success_image_heading != blank -%}
            <div class="hs-form__success-media">
              {%- if section.settings.success_image_heading != blank -%}
                <{{ section.settings.step_heading_tag }} class="{{ section.settings.step_heading_size | default: 'title-sm' }}">
                  {{- section.settings.success_image_heading -}}
                </{{section.settings.step_heading_tag}}>
              {%- endif -%}

              {%- if section.settings.success_image_text != blank -%}
                {{ section.settings.success_image_text }}
              {%- endif -%}

              {%- if section.settings.success_image != blank -%}
                {%- liquid
                  assign success_image = section.settings.success_image
                  assign success_sizes = '(min-width: 990px) 720px, 100vw'
                  assign success_widths = '400,600,800,1000,1200,1400,1600'
                -%}
                {%- if section.settings.success_image_link != blank -%}
                  <a href="{{ section.settings.success_image_link }}"{% if section.settings.success_image_alt != blank %} aria-label="{{ section.settings.success_image_alt | escape }}"{% endif %}>
                    {{- success_image | image_url: width: success_image.width | image_tag: loading: 'lazy', sizes: success_sizes, widths: success_widths, is: 'lazy-image', class: 'w-full h-auto', alt: section.settings.success_image_alt -}}
                  </a>
                {%- else -%}
                  {{- success_image | image_url: width: success_image.width | image_tag: loading: 'lazy', sizes: success_sizes, widths: success_widths, is: 'lazy-image', class: 'w-full h-auto', alt: section.settings.success_image_alt -}}
                {%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </hubspot-form>

    {%- endif -%}
  </div>
</div>

