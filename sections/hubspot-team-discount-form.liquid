{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign total_steps = step_blocks.size
-%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
  }
</style>

<div class="section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}">
  <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    {%- if total_steps == 0 -%}
      {%- if request.design_mode -%}
        <p>{{ 'Add at least one Step block to render this form.' }}</p>
      {%- endif -%}
    {%- else -%}
      <hubspot-form
        class="hs-form"
        data-portal-id="{{ section.settings.portal_id }}"
        data-form-guid="{{ section.settings.form_guid }}"
        data-page-name="{{ page_title | default: shop.name | escape }}"
        data-error-message="{{ section.settings.error_message | escape }}"
        data-loading-label="{{ section.settings.loading_label | escape }}"
        data-branch-rules="{{ section.settings.branch_rules | escape }}"
        data-consent-mode="{{ section.settings.consent_mode }}"
        data-consent-subscription-id="{{ section.settings.consent_subscription_id }}"
        data-consent-text="{{ section.settings.consent_text | escape }}"
      >
        <form novalidate>
          {%- for step in step_blocks -%}
            {%- liquid
              assign index = forloop.index
              assign is_first = false
              assign is_last = false
              if forloop.first
                assign is_first = true
              endif
              if forloop.last
                assign is_last = true
              endif
            -%}
            {%- render 'hubspot-form-step',
              step: step,
              section: section,
              index: index,
              total: total_steps,
              is_first: is_first,
              is_last: is_last
            -%}
          {%- endfor -%}

          {%- comment -%}Spam trap: hidden from people, tempting to bots. Never sent to HubSpot.{%- endcomment -%}
          <div class="sr-only" aria-hidden="true">
            <label for="HsTrap-{{ section.id }}">{{ 'Leave this field empty' }}</label>
            <input type="text" id="HsTrap-{{ section.id }}" name="website_hp" tabindex="-1" autocomplete="off" data-honeypot>
          </div>
        </form>

        <div class="hs-form__success rte" data-success hidden>
          {%- if section.settings.success_heading != blank -%}
            <h3 class="{{ section.settings.step_heading_size | default: 'title-sm' }}">{{ section.settings.success_heading }}</h3>
          {%- endif -%}
          {{ section.settings.success_message }}
        </div>
      </hubspot-form>

    {%- endif -%}
  </div>
</div>

