{%- comment -%} TBG custom code: Slideshow where each slide works like Image with text overlay {%- endcomment -%}
{%- liquid
  assign first_block = section.blocks | first
  if first_block != blank
    assign first_block_image = first_block.settings.image
    assign first_block_image_mobile = first_block.settings.image_mobile | default: first_block_image
  endif
-%}

{%- comment -%} TBG custom code: preload LCP image of first slide {%- endcomment -%}
{%- if section.index == 1 and first_block_image != blank -%}
  {%- capture lcp_sizes -%}{% if section.settings.full_width %}100vw{% else %}min({{ settings.page_width }}px, 100vw){% endif %}{%- endcapture -%}
  {%- comment %}theme-check-disable AssetPreload{% endcomment %}
  {%- if first_block.settings.image_mobile != blank -%}
    <link rel="preload" as="image"
      imagesrcset="{{ first_block_image_mobile | image_url: width: 400 }} 400w, {{ first_block_image_mobile | image_url: width: 600 }} 600w, {{ first_block_image_mobile | image_url: width: 800 }} 800w"
      imagesizes="100vw"
      media="(max-width: 767px)"
      fetchpriority="high">
  {%- endif -%}
  <link rel="preload" as="image"
    imagesrcset="{{ first_block_image | image_url: width: 600 }} 600w, {{ first_block_image | image_url: width: 1000 }} 1000w, {{ first_block_image | image_url: width: 1400 }} 1400w, {{ first_block_image | image_url: width: 1800 }} 1800w, {{ first_block_image | image_url: width: 2200 }} 2200w"
    imagesizes="{{ lcp_sizes }}"
    {% if first_block.settings.image_mobile != blank %}media="(min-width: 768px)"{% endif %}
    fetchpriority="high">
  {%- comment %}theme-check-enable AssetPreload{% endcomment %}
{%- endif -%}

<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
    {%- if first_block_image != blank and section.settings.image_height == 'adapt' %}
      --ratio-percent: {{ 1 | divided_by: first_block_image.aspect_ratio | times: 100 }}%;
    {% endif -%}
  }

  {%- if first_block_image_mobile != blank and section.settings.image_height_mobile == 'adapt' %}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        --ratio-percent: {{ 1 | divided_by: first_block_image_mobile.aspect_ratio | times: 100 }}%;
      }
    }
  {% endif -%}

  /* TBG custom code: per-slide colors */
  {%- for block in section.blocks %}
  #shopify-section-{{ section.id }} .tbg-slide-{{ block.id }} {
    {%- render 'section-variables', section: block -%}
  }
  {%- endfor %}

  /* TBG custom code: overlay + buttons row */
  #shopify-section-{{ section.id }} .tbg-slideshow .banner__overlay {
    background: rgb(var(--color-overlay) / var(--overlay-opacity));
  }
  #shopify-section-{{ section.id }} .tbg-slideshow .banner__content {
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .tbg-buttons .button {
    margin: 0;
  }
  /* TBG custom code: spacing between content elements */
  #shopify-section-{{ section.id }} .tbg-slideshow .banner__box > * + * {
    margin-block-start: {{ section.settings.content_gap }}px;
  }
  /* TBG custom code: extra empty space above image / buttons (per slide) */
  #shopify-section-{{ section.id }} .tbg-slideshow .banner__box > * + .tbg-space-above {
    margin-block-start: calc({{ section.settings.content_gap }}px + var(--tbg-space, 0px));
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .tbg-slideshow .banner__box > * + * {
      margin-block-start: {{ section.settings.content_gap_mobile }}px;
    }
    #shopify-section-{{ section.id }} .tbg-slideshow .banner__box > * + .tbg-space-above {
      margin-block-start: calc({{ section.settings.content_gap_mobile }}px + var(--tbg-space-mobile, 0px));
    }
  }

  /* TBG custom code: content animation on slide change */
  #shopify-section-{{ section.id }} .tbg-slideshow .banner__box {
    transition: opacity 0.7s ease 0.2s, transform 0.7s ease 0.2s;
  }
  #shopify-section-{{ section.id }} .tbg-slideshow .flickity-enabled .banner:not(.is-selected) .banner__box {
    opacity: 0;
    transform: translateY(30px);
    transition-delay: 0s;
  }

  {%- if section.settings.edge_to_edge %}
  /* TBG custom code: slides cover full width, no side spacing */
  #shopify-section-{{ section.id }} .tbg-slideshow .slideshow .banner {
    width: 100%;
    max-width: none;
    margin-inline-end: 0;
  }
  #shopify-section-{{ section.id }} .tbg-slideshow .slideshow :is(.banner, .banner__overlay) {
    border-radius: 0;
  }
  {%- endif %}
</style>

{%- if section.blocks.size > 0 -%}
<div class="tbg-slideshow section section--padding{% if section.settings.divider %} section--divider{% endif %}{% if section.settings.rounded %} section--rounded relative{% endif %}"{% comment %} TBG custom code: transparent header {% endcomment %}{% if section.settings.transparent_header %} allow-transparent-header{% endif %}>
  <div class="{% unless section.settings.full_width %}page-width {% endunless %}relative">
    {%- if section.blocks.size > 1 and section.settings.autoplay -%}
      <button
        type="button"
        class="slideshow-control flex items-center justify-center rounded-full sr-only"
        is="control-button"
        aria-controls="Slider-{{ section.id }}"
        aria-live="polite"
        aria-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
        data-pause-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
        data-play-label="{{ 'sections.slideshow.play_slideshow' | t | escape }}"
      >
        <span class="slideshow-control__pause">{%- render 'icon', icon: 'pause' -%}</span>
        <span class="slideshow-control__play">{%- render 'icon', icon: 'play' -%}</span>
      </button>
    {%- endif -%}

    <slideshow-element
      id="Slider-{{ section.id }}" class="slideshow block"{% if section.settings.autoplay %} autoplay autoplay-speed="{{ section.settings.autoplay_speed }}"{% endif %}
      role="region"
      aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
      aria-label="{{ section.settings.accessibility_info | escape }}"
    >
      {%- capture sizes -%}{% if section.settings.full_width %}100vw{% else %}min({{ settings.page_width }}px, 100vw){% endif %}{%- endcapture -%}
      {%- for block in section.blocks -%}
        {%- liquid
          if section.index == 1 and forloop.first
            assign loading = 'eager'
            assign fetchpriority = 'high'
            assign lazyimage = null
          else
            assign loading = 'lazy'
            assign fetchpriority = 'low'
            assign lazyimage = 'lazy-image'
          endif

          assign with_gradient = false
          if block.settings.gradient_highlight != blank and block.settings.gradient_highlight != 'rgba(0,0,0,0)'
            assign with_gradient = true
          endif

          assign has_content = false
          if block.settings.subheading != blank or block.settings.heading != blank or block.settings.text != blank or block.settings.image_inside != blank or block.settings.button_label != blank or block.settings.button_label_2 != blank
            assign has_content = true
          endif
        -%}
        <div class="tbg-slide-{{ block.id }} banner media--{{ section.settings.image_height }} mobile:media--{{ section.settings.image_height_mobile }} w-full overflow-hidden relative" data-type="image" {{ block.shopify_attributes }}>
          <media-element class="banner__media block w-full h-full overflow-hidden"{% if section.settings.enable_parallax %} data-parallax="0.3" data-parallax-dir="{{ section.settings.parallax_direction }}"{% endif %}>
            <animate-element data-animate="zoom-out" class="media media--height block w-full h-full relative overflow-hidden" paused>
              <picture class="media media--height block w-full h-full relative overflow-hidden">
                {%- if block.settings.image != blank -%}
                  {%- if block.settings.image_mobile -%}
                    <source
                      media="(max-width: 767px)"
                      srcset="{{ block.settings.image_mobile | image_url: width: '400x' }} 400w, {{ block.settings.image_mobile | image_url: width: '600x' }} 600w, {{ block.settings.image_mobile | image_url: width: '800x' }} 800w, {{ block.settings.image_mobile | image_url: width: '1000x' }} 1000w"
                      width="{{ block.settings.image_mobile.width }}"
                      height="{{ block.settings.image_mobile.height }}"
                    >
                  {%- endif -%}
                  {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading, fetchpriority: fetchpriority, sizes: sizes, widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', is: lazyimage, class: 'banner__image' -}}
                {%- else -%}
                  {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
                  {{- placeholder | placeholder_svg_tag: 'banner__image banner__overlay placeholder' -}}
                {%- endif -%}
              </picture>
            </animate-element>
          </media-element>
          <span class="banner__overlay absolute top-0 left-0 w-full h-full pointer-events-none"></span>

          {%- if block.settings.slide_link != blank -%}
            <a href="{{ block.settings.slide_link }}" class="block absolute top-0 left-0 w-full h-full z-1" aria-hidden="true" tabindex="-1">&nbsp;</a>
          {%- endif -%}

          {%- if has_content -%}
            <div class="banner__content overflow-hidden absolute top-0 left-0 w-full h-full pointer-events-none">
              <div class="page-width w-full h-full flex {{ block.settings.content_position }} {{ block.settings.content_position_mobile }}">
                <div class="banner__box banner__box--{{ section.settings.content_width }} md:text-{{ block.settings.text_alignment }} text-{{ block.settings.text_alignment_mobile }}">
                  {%- if block.settings.subheading != blank -%}
                    <p class="banner__subheading heading uppercase leading-none tracking-widest {{ block.settings.subheading_size }}">
                      {{- block.settings.subheading -}}
                    </p>
                  {%- endif -%}

                  {%- if block.settings.heading != blank -%}
                    <{{ block.settings.heading_tag }} class="banner__title heading leading-none {{ block.settings.heading_size }}">
                      {%- render 'heading-content', content: block.settings.heading, style: block.settings.highlighted_text, scribble: block.settings.highlighted_scribble, gradient: with_gradient, delay: 1 -%}
                    </{{ block.settings.heading_tag }}>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="rte {{ block.settings.text_font }} {{ block.settings.text_size }}{% if block.settings.text_font == 'subtitle' %} uppercase leading-tight tracking-widest{% else %} leading-normal{% endif %}">
                      {{- block.settings.text -}}
                    </div>
                  {%- endif -%}

                  {%- if block.settings.image_inside != blank -%}
                    <div class="leading-none tbg-space-above" style="--tbg-space: {{ block.settings.image_inside_space }}px; --tbg-space-mobile: {{ block.settings.image_inside_space_mobile }}px;">
                      <figure class="media media--transparent relative inline-block">
                        {%- if block.settings.image_inside_width == 'custom' -%}
                          {%- capture style -%}--image-max-width: {{ block.settings.image_inside_max_width }}px; --image-max-width-mobile: {{ block.settings.image_inside_max_width_mobile }}px{%- endcapture -%}
                          {%- capture image_sizes -%}(max-width: 767px) min({{ block.settings.image_inside_max_width_mobile }}px, 100vw), min({{ block.settings.image_inside_max_width }}px, 100vw){%- endcapture -%}
                          {%- capture widths -%}{{ block.settings.image_inside_max_width_mobile }},{{ block.settings.image_inside_max_width_mobile | times: 2 }},{{ block.settings.image_inside_max_width }},{{ block.settings.image_inside_max_width | times: 2 }}{%- endcapture -%}
                        {%- else -%}
                          {%- assign style = '' -%}
                          {%- assign image_sizes = 'min(100vw, var(--page-width))' -%}
                          {%- assign widths = '50,75,100,150,200,300,400,500,750,1000,1250,1500,1750,2000' -%}
                        {%- endif -%}
                        {{- block.settings.image_inside | image_url: width: block.settings.image_inside.width | image_tag: loading: 'lazy', sizes: image_sizes, widths: widths, style: style, is: 'lazy-image', class: 'image-fit' -}}
                      </figure>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                    <div class="tbg-buttons tbg-space-above" style="--tbg-space: {{ block.settings.buttons_space }}px; --tbg-space-mobile: {{ block.settings.buttons_space_mobile }}px;">
                      <div class="inline-flex flex-wrap items-center gap-4 pointer-events-auto">
                        {%- if block.settings.button_label != blank -%}
                          {%- render 'button',
                            label: block.settings.button_label,
                            link: block.settings.button_link,
                            size: block.settings.button_size,
                            style: block.settings.button_style,
                            external: block.settings.button_external,
                            show_icon: block.settings.button_icon,
                            classes: 'button--fixed'
                          -%}
                        {%- endif -%}
                        {%- if block.settings.button_label_2 != blank -%}
                          {%- render 'button',
                            label: block.settings.button_label_2,
                            link: block.settings.button_link_2,
                            size: block.settings.button_size_2,
                            style: block.settings.button_style_2,
                            external: block.settings.button_external_2,
                            show_icon: block.settings.button_icon_2,
                            classes: 'button--fixed'
                          -%}
                        {%- endif -%}
                      </div>
                    </div>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </slideshow-element>

    {%- if section.blocks.size > 1 and section.settings.show_navigation -%}
      <div class="page-width absolute bottom-0 left-0 w-full pointer-events-none z-2">
        <div class="slideshow-content">
          <div class="slideshow-dots flex items-end justify-between">
            <button type="button" is="previous-button" class="hidden md:block pointer-events-auto" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}">
              {%- render 'icon', icon: 'arrow-left-long', class: 'transform' -%}
            </button>
            <slider-dots class="flickity-page-dots w-auto pointer-events-auto" aria-controls="Slider-{{ section.id }}">
              {%- for block in section.blocks -%}
                <button type="button" class="flickity-page-dot" data-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                  <span class="sr-only">{{ 'general.pagination.page' | t: number: forloop.index }}</span>
                </button>
              {%- endfor -%}
            </slider-dots>
            <button type="button" is="next-button" class="hidden md:block pointer-events-auto" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
              {%- render 'icon', icon: 'arrow-right-long', class: 'transform' -%}
            </button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Slideshow - Custom",
  "class": "tbg-slideshow-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "checkbox",
      "id": "transparent_header",
      "label": "t:sections.global.settings.transparent_header.label",
      "info": "t:sections.global.settings.transparent_header.info",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:sections.slideshow.settings.autoplay.label",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.autoplay == true }}",
      "type": "range",
      "id": "autoplay_speed",
      "min": 3,
      "max": 9,
      "step": 1,
      "unit": "s",
      "label": "t:sections.slideshow.settings.autoplay_speed.label",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "t:sections.slideshow.settings.show_navigation.label",
      "default": true
    },
    {
      "type": "select",
      "id": "image_height",
      "options": [
        {
          "label": "t:sections.global.settings.image_height.options__2.label",
          "value": "400px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__3.label",
          "value": "450px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__4.label",
          "value": "500px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__5.label",
          "value": "550px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__6.label",
          "value": "600px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__7.label",
          "value": "650px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__8.label",
          "value": "700px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__9.label",
          "value": "750px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__10.label",
          "value": "800px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__11.label",
          "value": "850px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__12.label",
          "value": "900px"
        },
        {
          "label": "t:sections.global.settings.image_height.options__13.label",
          "value": "100vh"
        },
        {
          "label": "t:sections.global.settings.image_height.options__14.label",
          "value": "adapt"
        }
      ],
      "default": "650px",
      "label": "t:sections.global.settings.image_height.label"
    },
    {
      "type": "select",
      "id": "content_width",
      "options": [
        {
          "value": "small",
          "label": "t:sections.global.settings.content_width.options__1.label"
        },
        {
          "value": "medium",
          "label": "t:sections.global.settings.content_width.options__2.label"
        },
        {
          "value": "large",
          "label": "t:sections.global.settings.content_width.options__3.label"
        }
      ],
      "default": "small",
      "label": "t:sections.global.settings.content_width.label"
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Spacing between elements",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_gap_mobile",
      "label": "Spacing between elements (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__mobile.content"
    },
    {
      "type": "select",
      "id": "image_height_mobile",
      "options": [
        {
          "label": "t:sections.global.settings.image_height_mobile.options__1.label",
          "value": "auto"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__2.label",
          "value": "200px"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__3.label",
          "value": "250px"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__4.label",
          "value": "300px"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__5.label",
          "value": "400px"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__6.label",
          "value": "500px"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__7.label",
          "value": "600px"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__8.label",
          "value": "100vh"
        },
        {
          "label": "t:sections.global.settings.image_height_mobile.options__10.label",
          "value": "adapt"
        }
      ],
      "default": "auto",
      "label": "t:sections.global.settings.image_height_mobile.label"
    },
    {
      "type": "header",
      "content": "t:sections.slideshow.settings.accessibility.content"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "t:sections.slideshow.settings.accessibility.label",
      "info": "t:sections.slideshow.settings.accessibility.info",
      "default": "t:sections.slideshow.settings.accessibility.default"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__colors.content"
    },
    {
      "type": "color",
      "id": "color_text",
      "label": "Arrows & dots color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "color_background",
      "label": "t:sections.global.settings.color_background.label"
    },
    {
      "type": "color_background",
      "id": "gradient_background",
      "label": "t:sections.global.settings.gradient_background.label"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "divider",
      "label": "t:sections.global.settings.divider.label",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "edge_to_edge",
      "label": "Remove side spacing on slides",
      "info": "Each slide covers the full screen width with no gap or rounded corners.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rounded",
      "default": false,
      "label": "t:sections.global.settings.rounded.label"
    },
    {
      "type": "checkbox",
      "id": "enable_parallax",
      "label": "t:sections.global.settings.enable_parallax.label",
      "default": false
    },
    {
      "visible_if": "{{ section.settings.enable_parallax == true }}",
      "type": "select",
      "id": "parallax_direction",
      "label": "t:sections.global.settings.parallax_direction.label",
      "default": "vertical",
      "options": [
        {
          "value": "vertical",
          "label": "t:sections.global.settings.parallax_direction.options__1.label"
        },
        {
          "value": "horizontal",
          "label": "t:sections.global.settings.parallax_direction.options__2.label"
        },
        {
          "value": "zoom",
          "label": "t:sections.global.settings.parallax_direction.options__3.label"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Image"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.global.settings.image.label"
        },
        {
          "type": "image_picker",
